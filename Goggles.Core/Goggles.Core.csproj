<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <!-- Build-time only: generates C# from the vendored .proto files; nothing of it ships. -->
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Messages only, no gRPC: Galaxy frames protobuf over a raw socket. Internal, so the wire
         types stay inside Core the way the JSON DTOs stay inside Api/<host>/Models. -->
    <Protobuf Include="Galaxy\Protocols\*.proto" GrpcServices="None" Access="Internal" ProtoRoot="Galaxy\Protocols" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Goggles.Core.Tests" />
  </ItemGroup>

</Project>
