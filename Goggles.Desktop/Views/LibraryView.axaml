<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Goggles.Desktop.ViewModels"
             xmlns:controls="using:Goggles.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Goggles.Desktop.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <UserControl.Styles>
        <Style Selector="Border.tile">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.tile:pointerover">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="#14808080" />
        </Style>
    </UserControl.Styles>

    <Grid>

        <!-- The library: search, toolbar, and grid/list — hidden entirely once a game is
             selected, replaced full-bleed by the detail page below. -->
        <DockPanel IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNull}}">

            <!-- A translucent grey reads correctly in both light and dark themes. -->
            <Border DockPanel.Dock="Top" Padding="16,12" Background="#18808080">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                    <TextBox Grid.Column="0"
                             PlaceholderText="Search your library"
                             Text="{Binding Search}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Status}"
                               VerticalAlignment="Center"
                               Opacity="0.7" />
                    <Button Grid.Column="2"
                            Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding !IsLoading}" />

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding AccountName}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   IsVisible="{Binding AccountName, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <Button Content="Sign out"
                                Command="{Binding ConfirmSignOutCommand}"
                                IsVisible="{Binding !IsConfirmingSignOut}" />

                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsConfirmingSignOut}">
                            <TextBlock Text="Sign out?" VerticalAlignment="Center" Opacity="0.8" />
                            <Button Content="Yes" Command="{Binding SignOutCommand}" />
                            <Button Content="No" Command="{Binding CancelSignOutCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Icon-driven toolbar: a Filter flyout, the existing genre picker, and a
                 layout/sort flyout — mirrors the redesigned toolbar in the Go/Wails port. -->
            <Border DockPanel.Dock="Top" Padding="16,8" Background="#0C808080">
                <StackPanel Orientation="Horizontal" Spacing="8">

                    <Button Content="⏷ Filter">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="4" MinWidth="180">
                                    <TextBlock Text="STATUS" FontSize="10" Opacity="0.5" Margin="4,0,0,4" />
                                    <Button Content="All"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetFilterCommand}"
                                            CommandParameter="{x:Static vm:LibraryFilter.All}" />
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetFilterCommand}"
                                            CommandParameter="{x:Static vm:LibraryFilter.Installed}">
                                        <TextBlock>
                                            <Run Text="Installed" />
                                            <Run Text="{Binding InstalledCount}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetFilterCommand}"
                                            CommandParameter="{x:Static vm:LibraryFilter.NotInstalled}">
                                        <TextBlock>
                                            <Run Text="Not installed" />
                                            <Run Text="{Binding NotInstalledCount}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </Button>
                                    <Button HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetFilterCommand}"
                                            CommandParameter="{x:Static vm:LibraryFilter.Playable}"
                                            ToolTip.Tip="Games with a build this machine can run">
                                        <TextBlock>
                                            <Run Text="Runs here" />
                                            <Run Text="{Binding PlayableCount}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Rectangle Width="1" Margin="4,2" Fill="#28808080" />

                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding Category}"
                              PlaceholderText="All genres"
                              MinWidth="150" />
                    <Button Content="✕"
                            Padding="8,4"
                            ToolTip.Tip="Clear genre"
                            Command="{Binding ClearCategoryCommand}"
                            IsVisible="{Binding Category, Converter={x:Static ObjectConverters.IsNotNull}}" />

                    <Rectangle Width="1" Margin="4,2" Fill="#28808080" />

                    <Button Content="⚙ View &amp; sort">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="4" MinWidth="180">
                                    <TextBlock Text="VIEW" FontSize="10" Opacity="0.5" Margin="4,0,0,4" />
                                    <Button Content="Grid"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetLayoutCommand}"
                                            CommandParameter="{x:Static vm:LibraryLayout.Grid}" />
                                    <Button Content="List"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetLayoutCommand}"
                                            CommandParameter="{x:Static vm:LibraryLayout.List}" />

                                    <TextBlock Text="SORT BY" FontSize="10" Opacity="0.5" Margin="4,10,0,4" />
                                    <Button Content="Title"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetSortCommand}"
                                            CommandParameter="{x:Static vm:LibrarySort.Title}" />
                                    <Button Content="Recently added"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetSortCommand}"
                                            CommandParameter="{x:Static vm:LibrarySort.RecentlyAdded}" />
                                    <Button Content="Release date"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetSortCommand}"
                                            CommandParameter="{x:Static vm:LibrarySort.ReleaseDate}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Border>

            <ProgressBar DockPanel.Dock="Top"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsLoading}"
                         Height="3" />

            <TextBlock DockPanel.Dock="Top"
                       Margin="16,12"
                       Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />

            <TextBlock DockPanel.Dock="Top"
                       Margin="16"
                       Opacity="0.6"
                       IsVisible="{Binding IsEmpty}"
                       Text="Nothing to show yet." />

            <!-- Grid view: cover-art tiles. -->
            <ScrollViewer IsVisible="{Binding Layout, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibraryLayout.Grid}}">
                <ListBox ItemsSource="{Binding Games}"
                         SelectedItem="{Binding SelectedGame}"
                         Background="Transparent"
                         Margin="12">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- 196 px of tile plus its 6 px margin each side; tiles stretch to fill the row. -->
                            <controls:TileWrapPanel MinItemWidth="208" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.Styles>
                        <!-- The tile draws itself; the item container just holds it. -->
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GameTileViewModel">
                            <Border Classes="tile" Margin="6" ToolTip.Tip="{Binding Title}">
                                <StackPanel Spacing="6">

                                    <!-- GOG's tile art is 196x110; keep that shape at any tile width. -->
                                    <controls:AspectRatioDecorator Ratio="0.5612">
                                        <Panel>
                                            <Border Background="#28808080"
                                                    CornerRadius="4"
                                                    IsVisible="{Binding HasNoCover}" />
                                            <Image Source="{Binding Cover}"
                                                   Stretch="UniformToFill" />

                                            <Border IsVisible="{Binding IsInstalled}"
                                                    Background="#CC1F7A3D"
                                                    CornerRadius="3"
                                                    Padding="6,2"
                                                    Margin="6"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="Installed" FontSize="10" Foreground="White" />
                                            </Border>
                                        </Panel>
                                    </controls:AspectRatioDecorator>

                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Platforms}"
                                                   FontSize="11"
                                                   Opacity="0.55" />
                                        <TextBlock Text="{Binding Details}"
                                                   FontSize="11"
                                                   Opacity="0.55"
                                                   IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <!-- List view: rows with trophy %, playtime, rating, and platform columns. -->
            <DockPanel IsVisible="{Binding Layout, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:LibraryLayout.List}}">
                <Grid DockPanel.Dock="Top"
                      ColumnDefinitions="48,*,70,80,110,110"
                      Margin="18,8"
                      ColumnSpacing="12">
                    <TextBlock Grid.Column="1" Text="TITLE" FontSize="10" Opacity="0.5" />
                    <TextBlock Grid.Column="2" Text="TROPHY" FontSize="10" Opacity="0.5" />
                    <TextBlock Grid.Column="3" Text="TIME" FontSize="10" Opacity="0.5" />
                    <TextBlock Grid.Column="4" Text="RATING" FontSize="10" Opacity="0.5" />
                    <TextBlock Grid.Column="5" Text="PLATFORM" FontSize="10" Opacity="0.5" />
                </Grid>

                <ScrollViewer>
                    <ListBox ItemsSource="{Binding Games}"
                             SelectedItem="{Binding SelectedGame}"
                             Background="Transparent"
                             Margin="12,0,12,12">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                            </Style>
                        </ListBox.Styles>

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameTileViewModel">
                                <Border Classes="row" Padding="6" CornerRadius="4" ToolTip.Tip="{Binding Title}">
                                    <Grid ColumnDefinitions="36,*,70,80,110,110" ColumnSpacing="12">
                                        <Panel Grid.Column="0" Width="36" Height="36">
                                            <Border Background="#28808080" CornerRadius="3" IsVisible="{Binding HasNoCover}" />
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        </Panel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Installed"
                                                       FontSize="10"
                                                       Opacity="0.6"
                                                       IsVisible="{Binding IsInstalled}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding TrophyLabel}" VerticalAlignment="Center" Opacity="0.85" />
                                        <TextBlock Grid.Column="3" Text="{Binding TimeLabel}" VerticalAlignment="Center" Opacity="0.85" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding RatingStars}"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.85"
                                                   ToolTip.Tip="{Binding RatingTooltip}" />
                                        <TextBlock Grid.Column="5" Text="{Binding Platforms}" VerticalAlignment="Center" FontSize="11" Opacity="0.55" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>

        </DockPanel>

        <!-- The full-page detail view — replaces the library entirely while a game is selected. -->
        <ContentControl Content="{Binding Detail}"
                         IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" />

    </Grid>

</UserControl>
