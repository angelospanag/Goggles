<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Goggles.Desktop.ViewModels"
             xmlns:platform="using:Goggles.Desktop.Platform"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Goggles.Desktop.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <UserControl.Styles>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Button.link:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- The address bar of a browser we drew ourselves: the user is typing a password into a
             page inside our window, so whose page it is should never be a matter of trust. -->
        <Border Name="AddressBar"
                DockPanel.Dock="Top"
                Padding="14,8"
                IsVisible="False"
                Background="#14808080"
                BorderBrush="#20808080"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center">
                <!-- A drawn padlock rather than the emoji, which renders as a yellow cartoon. -->
                <Path Data="M4,7 L4,4.5 A3,3 0 0 1 10,4.5 L10,7 M2.6,7 L11.4,7 A0.9,0.9 0 0 1 12.3,7.9 L12.3,13 A0.9,0.9 0 0 1 11.4,13.9 L2.6,13.9 A0.9,0.9 0 0 1 1.7,13 L1.7,7.9 A0.9,0.9 0 0 1 2.6,7 Z"
                      Stroke="{DynamicResource SystemBaseHighColor}"
                      StrokeThickness="1.3"
                      Opacity="0.55"
                      VerticalAlignment="Center"
                      Margin="0,1,0,0" />
                <TextBlock Text="{Binding Host}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Opacity="0.6" />
            </StackPanel>
        </Border>

        <ProgressBar DockPanel.Dock="Top"
                     Height="2"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsPageLoading}" />

        <!-- The escape hatch, kept quiet: an embedded browser will eventually meet a CAPTCHA it
             cannot handle, and without a way out the app is stuck rather than merely awkward. -->
        <Border Name="FallbackStrip"
                DockPanel.Dock="Bottom"
                Padding="14,6"
                IsVisible="False"
                Background="#0C808080"
                BorderBrush="#18808080"
                BorderThickness="0,1,0,0">
            <Button Classes="link"
                    HorizontalAlignment="Center"
                    Content="Sign in with your browser instead"
                    Click="OnShowPasteFallback" />
        </Border>

        <Border DockPanel.Dock="Bottom"
                Padding="14,10"
                Background="#22E06C6C"
                IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Error}" Foreground="#E06C6C" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <Grid>

            <platform:MacWebView Name="Browser" IsVisible="False" />

            <Border Name="PasteFallback" Padding="32">
                <StackPanel MaxWidth="520" Spacing="14" VerticalAlignment="Center">

                    <TextBlock Text="Sign in to GOG" FontSize="20" FontWeight="SemiBold" />

                    <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="13"
                               Text="Goggles opens GOG's sign-in page in your browser. When you finish, the browser lands on a blank-looking embed.gog.com page — copy that address and come back." />

                    <Button Content="Open GOG sign-in"
                            Command="{Binding OpenBrowserCommand}"
                            HorizontalAlignment="Left" />

                    <!-- Goggles can't clear another app's cookies, so a browser still signed in to
                         GOG goes straight back to that account. -->
                    <TextBlock TextWrapping="Wrap" Opacity="0.55" FontSize="12"
                               Text="Switching accounts? Your browser remembers GOG's last sign-in, so sign out on gog.com first or use a private window." />

                    <SelectableTextBlock Text="{Binding AuthorizationUrl}"
                                         FontSize="11"
                                         Opacity="0.4"
                                         TextWrapping="Wrap" />

                    <TextBox PlaceholderText="https://embed.gog.com/on_login_success?origin=client&amp;code=…"
                             Text="{Binding RedirectUrl}"
                             IsEnabled="{Binding !IsBusy}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Paste and sign in"
                                Classes="accent"
                                Click="OnPasteAndSignIn"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Sign in"
                                Command="{Binding SignInCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <ProgressBar IsIndeterminate="True"
                                     Width="90"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsBusy}" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>

    </DockPanel>

</UserControl>
